{
  "name": "reflect",
  "version": "2.0.0-m9",
  "description": "A local-first personal AI assistant whose memory is a folder of files you own.",
  "type": "module",
  "main": "src/server.js",
  "bin": {
    "reflect": "bin/reflect.js"
  },
  "files": [
    "bin",
    "src",
    "public",
    "README.md",
    "DESIGN.md",
    "scripts",
    "desktop"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node scripts/check-client.js && node --test --import ./tests/home.mjs \"tests/*.test.js\"",
    "test:live": "REFLECT_LIVE=1 node --test --import ./tests/home.mjs \"tests/*.test.js\"",
    "home": "node bin/reflect.js where",
    "e2e": "node scripts/e2e.js",
    "verify": "node scripts/verify.js",
    "soak": "node scripts/soak.js",
    "postinstall": "node scripts/vendor.js",
    "vendor": "node scripts/vendor.js",
    "update:extras": "npm update mermaid && node scripts/vendor.js",
    "desktop": "electron desktop/main.js",
    "fetch:llama": "node scripts/fetch-llama.js",
    "pack": "node scripts/fetch-llama.js && node scripts/fetch-whisper.js && node scripts/check-vendor.js && electron-builder --dir",
    "dist": "node scripts/fetch-llama.js && node scripts/fetch-whisper.js && node scripts/check-vendor.js && electron-builder",
    "fetch:whisper": "node scripts/fetch-whisper.js",
    "pull:whisper-model": "node scripts/pull-whisper-model.js",
    "check:client": "node scripts/check-client.js",
    "check:vendor": "node scripts/check-vendor.js",
    "dist:win": "node scripts/fetch-llama.js win-cpu-x64 && node scripts/fetch-whisper.js win32 && node scripts/check-vendor.js win32 && electron-builder --win --x64",
    "dist:linux": "node scripts/fetch-llama.js ubuntu-x64 && node scripts/fetch-whisper.js linux && node scripts/check-vendor.js linux && electron-builder --linux --x64",
    "install:voice": "npm install --include=optional onnxruntime-node phonemizer && node scripts/pull-voice.js",
    "pull:voice": "node scripts/pull-voice.js"
  },
  "keywords": [
    "local-first",
    "ollama",
    "memory",
    "assistant"
  ],
  "author": "odomcl22",
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.reflect.app",
    "productName": "Reflect",
    "extraMetadata": {
      "main": "desktop/main.js"
    },
    "files": [
      "src/**/*",
      "public/**/*",
      "desktop/**/*",
      "package.json",
      "!node_modules/{mermaid,katex,codemirror,@codemirror,@lezer,@mermaid-js,cytoscape*,d3,d3-*,dagre-d3-es,roughjs,dompurify,marked,lodash-es}/**"
    ],
    "extraResources": [
      {
        "from": "vendor/llama",
        "to": "llama",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "vendor/whisper",
        "to": "whisper",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    }
  },
  "optionalDependencies": {
    "mermaid": "11.16.1",
    "katex": "0.16.25",
    "codemirror": "6.0.2",
    "@codemirror/lang-html": "6.4.11",
    "@codemirror/lang-javascript": "6.2.4",
    "@codemirror/lang-json": "6.0.2",
    "onnxruntime-node": "^1.29.0",
    "phonemizer": "^1.2.1"
  }
}
